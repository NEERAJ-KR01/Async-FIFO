module async_fifo #(parameter width =8, depth=4)
  // Write operation
  (input wr_clk, wr_rst, wr_en,
   input [width-1:0]din,
   output full,
   //Read operation
   input rd_clk,rd_rst,rd_en,
   output reg[width-1:0]dout,
   output empty  );
  localparam addr_width =$clog2(depth);
  localparam ptr = addr_width + 1;
  //memory
  reg[width-1:0]mem[depth-1:0];
  //Pointer Bin + Gray
  reg[ptr-1:0]wr_bin,wr_gray;
  reg[ptr-1:0]rd_bin,rd_gray;
 assign wr_gray = wr_bin^(wr_bin>>1);
 assign rd_gray = rd_bin^(rd_bin>>1);
  // Synchornizer
  reg[ptr-1:0]wr_gray_sync1,wr_gray_sync2;
  always@(posedge rd_clk or posedge rd_rst)begin
    if(rd_rst)begin
      {wr_gray_sync1,wr_gray_sync2}<=0;
    end
      else begin
       wr_gray_sync1 <= wr_gray;
       wr_gray_sync2 <= wr_gray_sync1;
      end
  end
  // Reverse Synchronizer
  reg[ptr-1:0]rd_gray_sync1,rd_gray_sync2;
  always@(posedge wr_clk or posedge wr_rst)begin
    if(wr_rst)begin
      {rd_gray_sync1,rd_gray_sync2}<=0;
    end
    else begin
      rd_gray_sync1 <= rd_gray;
      rd_gray_sync2 <=rd_gray_sync1;
    end
  end
  //Write operation
  always@(posedge wr_clk or posedge wr_rst )begin
    if(wr_rst)begin
          wr_bin<=0; 
    end
      else if(wr_en && !full)begin
        mem[wr_bin[addr_width-1:0]] <=din;
            wr_bin <= wr_bin +1;
      end
    end
 // Read operation 
    always@(posedge rd_clk or posedge rd_rst)begin
      if(rd_rst)begin
            rd_bin <=0;
            dout <=0;  
      end
        else if(rd_en && !empty)begin
          dout<=mem[rd_bin[addr_width-1:0]];
                 rd_bin <= rd_bin +1;
        end
      end
  assign empty = (rd_gray == wr_gray_sync2);
  assign full = (wr_gray == {~rd_gray_sync2[ptr-1:ptr-2],rd_gray_sync2[ptr-3:0]});
  						 // {~rd_gray_sync2[2:1],rd_gray[0]};
endmodule

module tb;
  parameter width =8, depth=4;
  reg wr_clk,wr_rst,wr_en;
  reg[width-1:0]din;
  wire full;
  reg rd_clk,rd_rst,rd_en;
  wire [width-1:0]dout;
  wire empty;
  
  async_fifo #(.width(width),.depth(depth))uut(.*);
  // WRITE CLK
   initial begin
      wr_clk =0;
       forever #5 wr_clk = ~wr_clk;
   end
  // READ CLK
     initial begin
       rd_clk = 0;
        forever #7 rd_clk = ~ rd_clk;
     end
  initial begin
     wr_rst =1;
     rd_rst=1;
    wr_en=0;
    rd_en=0;
    din=0;
    #20 
    wr_rst =0;
    rd_rst=0;
    // Write data
          wr_en=1;
    @(posedge wr_clk);
      din=8'hA1;
    @(posedge wr_clk);
       din=8'hB2;
    @(posedge wr_clk);
       din=8'hC3;
    @(posedge wr_clk);
       din=8'hD4;  // mem Full
    
    @(posedge wr_clk);
       wr_en=0;
   //Read data
      #30
    @(posedge rd_clk);
      rd_en=1;
    @(posedge rd_clk);
    
    @(posedge rd_clk);
    
    @(posedge rd_clk);
    
    @(posedge rd_clk); // empty
        rd_en=0;
    #50
    $finish;
  end
endmodule
    
    
    
           
    
     
   
      
      
